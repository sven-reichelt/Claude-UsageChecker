<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ClaudeUsageChecker.Core</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- For overwriting the token buffer deliberately before releasing it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeUsageChecker.Core.Tests" />
  </ItemGroup>

  <!--
    The language files travel along as embedded resources - deliberately not as
    satellite assemblies from .resx. The release is a trimmed single file, and
    satellites are the route with the most traps there, while embedded files
    survive every trimming pass unchanged.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Localization/Texts/*.json" />
  </ItemGroup>

</Project>
