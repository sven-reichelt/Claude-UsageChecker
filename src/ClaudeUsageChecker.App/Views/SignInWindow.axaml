<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClaudeUsageChecker.App.Views.SignInWindow"
        Width="500" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

  <StackPanel Margin="20" Spacing="16">

    <TextBlock x:Name="Heading" FontWeight="SemiBold" FontSize="15" />

    <TextBlock x:Name="Intro" TextWrapping="Wrap" FontSize="12" Opacity="0.85" />

    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="4" Padding="12">
      <StackPanel Spacing="8">
        <TextBlock x:Name="Step1" FontWeight="Medium" FontSize="12" />
        <Button x:Name="OpenBrowserButton" HorizontalAlignment="Left" />
        <TextBlock x:Name="UrlHint" TextWrapping="Wrap" FontSize="11" Opacity="0.7" />
        <TextBox x:Name="UrlBox" IsReadOnly="True" FontSize="10" MaxHeight="60" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="4" Padding="12">
      <StackPanel Spacing="8">
        <TextBlock x:Name="Step2" FontWeight="Medium" FontSize="12" />
        <TextBox x:Name="CodeBox" />
        <Button x:Name="CompleteButton" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>

    <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" />

    <Grid ColumnDefinitions="*,Auto">
      <TextBlock x:Name="SignedInText" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
      <Button Grid.Column="1" x:Name="CloseButton" />
    </Grid>

  </StackPanel>
</Window>
