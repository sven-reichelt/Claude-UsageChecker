<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClaudeUsageChecker.App.Views.UsageAlertWindow"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        ShowActivated="False"
        Background="Transparent">

  <!-- ShowActivated is off on purpose. The notice arrives while somebody is in
       the middle of something else; taking the keyboard away from them would
       send the next keystroke here - and an Enter meant for their own window
       would confirm a notice they never read. The button is not the default
       one for the same reason.

       The frame takes the colour of the stage, like the icon: yellow or red. -->
  <Border x:Name="Frame" Padding="18"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          BorderBrush="{DynamicResource WarningBrush}"
          BorderThickness="2"
          CornerRadius="6">
    <StackPanel Spacing="14">

      <TextBlock x:Name="HeadingText" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"
                 Foreground="{DynamicResource WarningBrush}" />

      <TextBlock x:Name="PreviewText" FontSize="11" Opacity="0.7" TextWrapping="Wrap" IsVisible="False" />

      <!-- One entry per limit. A second limit reaching a stage while the notice is
           still open joins it here instead of opening a window on top. -->
      <StackPanel x:Name="EntriesPanel" Spacing="10" />

      <TextBlock x:Name="AutoCloseText" FontSize="11" Opacity="0.7" TextWrapping="Wrap" IsVisible="False" />

      <Button x:Name="AcknowledgeButton"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

    </StackPanel>
  </Border>
</Window>
