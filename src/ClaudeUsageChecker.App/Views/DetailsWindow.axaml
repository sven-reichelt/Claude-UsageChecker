<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClaudeUsageChecker.App.Views.DetailsWindow"
        Title="Claude UsageChecker"
        Width="380" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="Transparent">

  <!-- No system window frame, but one of our own in the colour of the icon.
       That visibly ties the window to the application instead of letting it
       look like any old dialog. -->
  <Border Padding="18"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          BorderBrush="{DynamicResource AccentBrush}"
          BorderThickness="1"
          CornerRadius="6">
    <StackPanel Spacing="14">

      <TextBlock Text="Claude UsageChecker" FontWeight="SemiBold" FontSize="15"
                 Foreground="{DynamicResource AccentBrush}" />

      <StackPanel x:Name="WindowsPanel" Spacing="12" />

      <Border x:Name="ExtraUsageBorder" IsVisible="False"
              Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
              CornerRadius="4" Padding="10">
        <StackPanel x:Name="ExtraUsagePanel" Spacing="4" />
      </Border>

      <Border x:Name="MessageBorder" IsVisible="False"
              Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
              CornerRadius="4" Padding="10">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="12" />
      </Border>

      <Border x:Name="SignInNoticeBorder" IsVisible="False"
              Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
              CornerRadius="4" Padding="10">
        <TextBlock x:Name="SignInNoticeText" TextWrapping="Wrap" FontSize="12" />
      </Border>

      <Border x:Name="UpdateBorder" IsVisible="False"
              Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
              CornerRadius="4" Padding="10">
        <StackPanel Spacing="8">
          <TextBlock x:Name="UpdateText" TextWrapping="Wrap" FontSize="12" />
          <!-- Stacked, not side by side: with a 380 pixel window some 324 pixels
               remain after the margins, while the two labels need a good 420
               together. Side by side, the second button extended past the
               window. -->
          <StackPanel Spacing="6" HorizontalAlignment="Stretch">
            <Button x:Name="InstallButton"
                    IsVisible="False" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
            <Button x:Name="UpdateButton"
                    IsVisible="False" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Separator />

      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="FooterText" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
        <Button Grid.Column="1" x:Name="RefreshButton" />
      </Grid>

    </StackPanel>
  </Border>
</Window>
