<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClaudeUsageChecker.App.Views.UpdateAvailableWindow"
        Width="400" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        ShowActivated="False"
        Background="Transparent">

  <!-- Found by the check in the background, so it arrives while the user is busy
       with something else. Like the usage notice it does not take the keyboard,
       and neither button is the default: a keystroke meant for another window
       must not start an update, nor put one off. -->
  <Border Padding="20"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          BorderBrush="{DynamicResource AccentBrush}"
          BorderThickness="1"
          CornerRadius="6">
    <StackPanel Spacing="12">

      <TextBlock x:Name="HeadingText" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"
                 Foreground="{DynamicResource AccentBrush}" />

      <TextBlock x:Name="MessageText" FontSize="12" TextWrapping="Wrap" />

      <TextBlock x:Name="HintText" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />

      <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" IsVisible="False" />

      <StackPanel Spacing="6">
        <Button x:Name="InstallButton"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button x:Name="ReleasePageButton" IsVisible="False"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button x:Name="LaterButton"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </StackPanel>

    </StackPanel>
  </Border>
</Window>
