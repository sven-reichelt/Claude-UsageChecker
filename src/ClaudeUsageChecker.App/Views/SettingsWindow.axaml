<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ClaudeUsageChecker.App.Views"
        x:Class="ClaudeUsageChecker.App.Views.SettingsWindow"
        Width="720" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

  <!-- The window grows with its content and cannot be resized. On a low screen
       it therefore reached past the bottom edge - and took the "save" button
       with it. Hence two safeguards: the button row is docked at the bottom and
       stays outside the scroll area, so that it remains reachable however low
       the screen; and the content above it is capped to the working area when
       the window opens. The value here applies until a screen is known.

       The settings sit in two columns rather than one strip: in a single column
       the window grew tall and narrow, which meant scrolling on a laptop screen
       for settings that fit side by side comfortably. -->
  <DockPanel LastChildFill="True">

    <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,20" Spacing="18">
      <Separator />
      <!-- The version takes the width it needs, and the support buttons are
           centred in what is left. With the middle column shared evenly, a
           pre-release label ran underneath the buttons. -->
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <!-- Clicking it five times reveals the choice of update channel. A
             cursor of its own would give it away; it is meant to be found by
             someone looking, not noticed by everyone. -->
        <TextBlock x:Name="VersionText" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
        <!-- Between the version and the buttons, in the middle of the row: in
             view whenever the settings are open, and out of the way of saving. -->
        <views:SupportLinks Grid.Column="1" x:Name="Support" ImageHeight="28" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Margin="12,0,12,0" />
        <Button Grid.Column="2" x:Name="CancelButton" Margin="0,0,8,0" />
        <Button Grid.Column="3" x:Name="SaveButton" IsDefault="True" />
      </Grid>
    </StackPanel>

    <ScrollViewer x:Name="ContentScroller" MaxHeight="760"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <Grid Margin="20" ColumnDefinitions="*,Auto,*" ColumnSpacing="20">

        <!-- Left: who the application signs in as, how it behaves and looks. -->
        <StackPanel Grid.Column="0" Spacing="18">

          <!-- Both routes to a token, side by side and always both. Which one
               is in use says nothing about whether the other would work, and
               that is exactly the question when something is wrong. -->
          <StackPanel Spacing="8">
            <TextBlock x:Name="AccountsHeading" FontWeight="SemiBold" />

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
              <TextBlock x:Name="AccountCliLabel" FontSize="12" Margin="0,0,12,0" />
              <TextBlock Grid.Column="1" x:Name="AccountCliStatus" FontSize="12"
                         TextWrapping="Wrap" Opacity="0.8" />

              <TextBlock Grid.Row="1" x:Name="AccountOwnLabel" FontSize="12" Margin="0,0,12,0" />
              <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AccountOwnStatus" FontSize="12"
                         TextWrapping="Wrap" Opacity="0.8" />

              <!-- The plan of the account the figures come from. Hidden until
                   it is known: a guessed plan would be worse than none. -->
              <TextBlock Grid.Row="2" x:Name="AccountPlanLabel" FontSize="12" Margin="0,0,12,0"
                         IsVisible="False" />
              <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AccountPlanStatus" FontSize="12"
                         TextWrapping="Wrap" Opacity="0.8" IsVisible="False" />
            </Grid>
          </StackPanel>

          <Separator />

          <StackPanel Spacing="8">
            <TextBlock x:Name="SignInHeading" FontWeight="SemiBold" />
            <TextBlock x:Name="SignInStatus" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="SignInButton" />
              <Button x:Name="SignOutButton" />
            </StackPanel>
          </StackPanel>

          <Separator />

          <StackPanel Spacing="10">
            <TextBlock x:Name="BehaviourHeading" FontWeight="SemiBold" />

            <Grid ColumnDefinitions="*,Auto" >
              <TextBlock x:Name="IntervalLabel" VerticalAlignment="Center" FontSize="12"
                         TextWrapping="Wrap" Margin="0,0,8,0" />
              <NumericUpDown Grid.Column="1" x:Name="IntervalBox"
                             Minimum="180" Maximum="3600" Increment="60" Width="120" />
            </Grid>

            <CheckBox x:Name="LaunchAtLoginBox" Classes="switch" />
            <TextBlock x:Name="RelocationHint" IsVisible="False" TextWrapping="Wrap"
                       FontSize="11" Opacity="0.75" Margin="24,-4,0,0" />
            <CheckBox x:Name="AutoUpdateBox" Classes="switch" />
            <!-- Unavailable while automatic updates are on: they check at startup
                 regardless, so this switch would say something that is not so. -->
            <CheckBox x:Name="CheckUpdatesBox" Classes="switch" />
            <!-- The refresh button in the details window fetches the figures.
                 With this it looks for a new version on the way - one press
                 instead of two, and switched off for whoever would rather the
                 network was not touched more than necessary. -->
            <CheckBox x:Name="RefreshChecksUpdatesBox" Classes="switch" />
          </StackPanel>

          <Separator />

          <!-- On this side since the notices arrived on the other: the right
               column had grown so far past this one that the window scrolled,
               with the new choices below its edge. -->
          <StackPanel Spacing="10">
            <TextBlock x:Name="ThemeHeading" FontWeight="SemiBold" />
            <TextBlock x:Name="ThemeHint" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="ThemeLabel" VerticalAlignment="Center" FontSize="12"
                         TextWrapping="Wrap" Margin="0,0,8,0" />
              <ComboBox Grid.Column="1" x:Name="ThemeBox" Width="200" />
            </Grid>
          </StackPanel>

          <!-- Hidden until the version number at the bottom has been clicked five
               times. Not a secret worth keeping, but not a choice to stumble into
               either: a pre-release is meant for whoever agreed to test one. It
               stays visible while one is selected, so there is always a way back;
               on the published releases it is gone again at the next opening. -->
          <StackPanel x:Name="ChannelSection" Spacing="10" IsVisible="False">
            <Separator />
            <TextBlock x:Name="ChannelHeading" FontWeight="SemiBold" />
            <TextBlock x:Name="ChannelHint" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="ChannelLabel" VerticalAlignment="Center" FontSize="12"
                         TextWrapping="Wrap" Margin="0,0,8,0" />
              <ComboBox Grid.Column="1" x:Name="ChannelBox" Width="200" />
            </Grid>
          </StackPanel>

        </StackPanel>

        <!-- A hairline between the columns: without it the two halves read as
             one wide, muddled block. -->
        <Rectangle Grid.Column="1" Width="1" VerticalAlignment="Stretch"
                   Fill="{DynamicResource SystemControlBackgroundBaseLowBrush}" />

        <!-- Right: which language it speaks, when it changes colour, and when it
             speaks up. -->
        <StackPanel Grid.Column="2" Spacing="18">

          <StackPanel Spacing="10">
            <TextBlock x:Name="LanguageHeading" FontWeight="SemiBold" />
            <TextBlock x:Name="LanguageHint" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" FontSize="12"
                         TextWrapping="Wrap" Margin="0,0,8,0" />
              <!-- The language names are each written in their own language and are
                   therefore not translated - someone who switched the interface to
                   Russian by accident will recognise "Deutsch". -->
              <ComboBox Grid.Column="1" x:Name="LanguageBox" Width="200" />
            </Grid>
          </StackPanel>


          <Separator />

          <StackPanel Spacing="10">
            <TextBlock x:Name="ThresholdHeading" FontWeight="SemiBold" />
            <TextBlock x:Name="ThresholdIntro" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="WarningLabel" VerticalAlignment="Center" FontSize="12"
                         TextWrapping="Wrap" Margin="0,0,8,0" />
              <NumericUpDown Grid.Column="1" x:Name="WarningThresholdBox"
                             Minimum="5" Maximum="100" Increment="5" Width="120" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="CriticalLabel" VerticalAlignment="Center" FontSize="12"
                         TextWrapping="Wrap" Margin="0,0,8,0" />
              <NumericUpDown Grid.Column="1" x:Name="CriticalThresholdBox"
                             Minimum="5" Maximum="100" Increment="5" Width="120" />
            </Grid>

            <TextBlock x:Name="ThresholdHint" IsVisible="False" TextWrapping="Wrap"
                       FontSize="11" Foreground="{DynamicResource CriticalBrush}" />
          </StackPanel>

          <Separator />

          <!-- Right below the thresholds, because they are the same thresholds:
               the notice speaks up exactly where the icon changes colour. -->
          <StackPanel Spacing="10">
            <TextBlock x:Name="AlertHeading" FontWeight="SemiBold" />
            <TextBlock x:Name="AlertHint" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />

            <CheckBox x:Name="AlertOnWarningBox" Classes="switch" />
            <CheckBox x:Name="AlertOnCriticalBox" Classes="switch" />
            <CheckBox x:Name="AlertOnExhaustedBox" Classes="switch" />

            <CheckBox x:Name="AlertAcknowledgeBox" Classes="switch" />
            <CheckBox x:Name="AlertOnTopBox" Classes="switch" />

            <!-- Only meaningful for a notice that closes by itself, and disabled
                 otherwise rather than hidden: the window would jump every time the
                 box above is ticked. -->
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="AlertAutoCloseLabel" VerticalAlignment="Center" FontSize="12"
                         TextWrapping="Wrap" Margin="0,0,8,0" />
              <NumericUpDown Grid.Column="1" x:Name="AlertAutoCloseBox"
                             Minimum="5" Maximum="3600" Increment="5" Width="120" />
            </Grid>

            <!-- The only way to see the notice for a limit used up without using
                 one up. It takes the choices above as they stand, saved or not. -->
            <Button x:Name="AlertPreviewButton" HorizontalAlignment="Left" />
          </StackPanel>

        </StackPanel>

      </Grid>
    </ScrollViewer>

  </DockPanel>
</Window>
