<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClaudeUsageChecker.App.Views.InstallPromptWindow"
        Width="460" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="Transparent">

  <Border Padding="20"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          BorderBrush="{DynamicResource AccentBrush}"
          BorderThickness="1"
          CornerRadius="6">
    <StackPanel Spacing="14">

      <TextBlock x:Name="HeadingText" FontWeight="SemiBold" FontSize="15"
                 Foreground="{DynamicResource AccentBrush}" />

      <!-- The language picker sits at the top: anyone who cannot read the
           sentences below should not have to hunt for it first. It takes effect
           at once, and the whole window relabels itself. -->
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0" />
        <ComboBox Grid.Column="1" x:Name="LanguageBox" HorizontalAlignment="Stretch" />
      </Grid>
      <TextBlock x:Name="LanguageHint" TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,-6,0,0" />

      <Separator />

      <TextBlock x:Name="IntroText" TextWrapping="Wrap" FontSize="12" />

      <TextBlock x:Name="ListIntroText" TextWrapping="Wrap" FontSize="12" />

      <StackPanel Spacing="4" Margin="8,0,0,0">
        <TextBlock x:Name="BulletCopyText" FontSize="12" TextWrapping="Wrap" />
        <TextBlock x:Name="TargetText" FontSize="11" Opacity="0.75" Margin="10,0,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="BulletAutostartText" FontSize="12" TextWrapping="Wrap" />
        <TextBlock x:Name="BulletRestartText" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>

      <TextBlock x:Name="OutroText" TextWrapping="Wrap" FontSize="11" Opacity="0.7" />

      <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" IsVisible="False" />

      <StackPanel Spacing="6">
        <Button x:Name="InstallButton"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        <Button x:Name="LaterButton"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </StackPanel>

    </StackPanel>
  </Border>
</Window>
