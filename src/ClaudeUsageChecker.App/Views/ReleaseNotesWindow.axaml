<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClaudeUsageChecker.App.Views.ReleaseNotesWindow"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="Transparent">

  <Border Padding="18"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          BorderBrush="{DynamicResource AccentBrush}"
          BorderThickness="1"
          CornerRadius="6">
    <StackPanel Spacing="14">

      <TextBlock x:Name="HeadlineText" FontWeight="SemiBold" FontSize="15"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource AccentBrush}" />

      <TextBlock x:Name="SubtitleText" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />

      <!-- Only appears when the changelog does not exist in this language and is
           therefore shown in English. An uncommented switch of language would be
           more confusing than the notice. -->
      <TextBlock x:Name="TranslationNotice" FontSize="11" Opacity="0.7"
                 TextWrapping="Wrap" IsVisible="False" />

      <!-- The changelog can grow long - a fixed height would be either too
           large for a small bug fix or too small for a bigger release. The window
           therefore grows with its content and only starts scrolling from this
           height. -->
      <ScrollViewer x:Name="ContentScroller" MaxHeight="440" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="NotesPanel" Spacing="16" Margin="0,0,6,0" />
      </ScrollViewer>

      <Separator />

      <Button x:Name="CloseButton" IsDefault="True"
              HorizontalAlignment="Right" />

    </StackPanel>
  </Border>
</Window>
