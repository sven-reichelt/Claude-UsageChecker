<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ClaudeUsageChecker</AssemblyName>
    <RootNamespace>ClaudeUsageChecker.App</RootNamespace>
    <ApplicationIcon>../../assets/icons/app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- COM-Interop verhindert Trimming und wird hier nicht gebraucht: Die
         Anwendung nutzt weder Ziehen-und-Ablegen noch Shell-Einbindung. -->
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <!--
    Einstellungen der Veroeffentlichung. Gemessen am 19.08.2026 gegen die
    unveraenderte Fassung (93 MB):

      nur komprimiert         45 MB, Start 7,2 s, 136 MB Arbeitsspeicher
      getrimmt + komprimiert  21 MB, Start 2,3 s,  87 MB Arbeitsspeicher

    Trimming gewinnt auf allen drei Achsen - entfernter Code muss auch nicht
    geladen und uebersetzt werden. Alle Fenster, das Kontextmenue und die
    Anmeldung wurden in der getrimmten Fassung von Hand nachgeprueft; die
    Warnungen der Trimm-Analyse betreffen Pfade, die diese Anwendung nicht geht.
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeUsageChecker.Core\ClaudeUsageChecker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeUsageChecker.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="../../assets/icons/*.png" Link="Assets/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../assets/icons/*.ico" Link="Assets/%(Filename)%(Extension)" />
    <!-- Der Aenderungsverlauf reist mit: Die Uebersicht nach einer
         Aktualisierung soll ohne Netzzugriff auskommen und genau das zeigen,
         was zur laufenden Fassung gehoert. Gut zehn Kilobyte Text. -->
    <AvaloniaResource Include="../../CHANGELOG.md" Link="Assets/CHANGELOG.md" />
    <!-- Die Uebersetzungen des Verlaufs. Deutsch ist die Quelle und bleibt in
         der Wurzel; das Repository fuehrt den Verlauf weiterhin auf Deutsch. -->
    <AvaloniaResource Include="../../docs/changelog/*.md" Link="Assets/changelog/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
