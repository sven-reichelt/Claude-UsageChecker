<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ClaudeUsageChecker</AssemblyName>
    <RootNamespace>ClaudeUsageChecker.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- COM interop prevents trimming and is not needed here: the application
         uses neither drag and drop nor shell integration. -->
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <!-- Windows dressing. A manifest is a Windows resource and an .ico a Windows
       icon; handing either to a macOS build is at best ignored and at worst an
       error. The Mac gets its icon from the application bundle instead. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) or $(RuntimeIdentifier.StartsWith('win'))">
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/icons/app.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Publishing settings. Measured on 2026-08-19 against the untouched build
    (93 MB):

      compressed only        45 MB, start 7.2 s, 136 MB memory
      trimmed + compressed   21 MB, start 2.3 s,  87 MB memory

    Trimming wins on all three counts - code that has been removed does not have
    to be loaded and compiled either. Every window, the context menu and the
    sign-in were checked by hand in the trimmed build; the warnings from the trim
    analysis concern paths this application does not take.
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeUsageChecker.Core\ClaudeUsageChecker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeUsageChecker.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="../../assets/icons/*.png" Link="Assets/%(Filename)%(Extension)" />
    <AvaloniaResource Include="../../assets/icons/*.ico" Link="Assets/%(Filename)%(Extension)" />
    <!-- The changelog travels along: the summary shown after an update has to
         manage without network access and show exactly what belongs to the
         running version. A good ten kilobytes of text. -->
    <AvaloniaResource Include="../../CHANGELOG.md" Link="Assets/CHANGELOG.md" />
    <!-- Its translations. English is the source and stays in the root; the
         translations, German among them, live under docs/changelog/. -->
    <AvaloniaResource Include="../../docs/changelog/*.md" Link="Assets/changelog/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
