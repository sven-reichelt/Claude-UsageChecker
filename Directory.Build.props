<Project>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NU1900 says the vulnerability database could not be reached, not that a
         package is vulnerable. Treating it as an error turns a hiccup on the
         network into a failed build, which happened on the CI on 2026-08-20.
         The findings themselves - NU1901 to NU1904 - stay errors. -->
    <WarningsNotAsErrors>NU1900</WarningsNotAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Versioning: overridden by the CI through -p:Version=x.y.z. -->
  <PropertyGroup>
    <VersionPrefix>0.7.1</VersionPrefix>
    <Product>Claude UsageChecker</Product>
    <Company>Sven Reichelt</Company>
    <Authors>Sven Reichelt</Authors>
    <Copyright>Copyright (c) 2026 Sven Reichelt</Copyright>
    <RepositoryUrl>https://github.com/sven-reichelt/Claude-UsageChecker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

</Project>
